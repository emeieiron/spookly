{
  "name": "pippo",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "contracts:build": "node --env-file-if-exists=.env.local scripts/forge.mjs build",
    "contracts:test": "node --env-file-if-exists=.env.local scripts/forge.mjs test",
    "contracts:deploy": "node --env-file=.env.local scripts/deploy.mjs",
    "smoke": "tsx --env-file=.env.local --tsconfig tsconfig.json scripts/smoke.ts",
    "dev:fork": "node scripts/dev-bundler.mjs",
    "test": "node --import tsx --test lib/*.test.ts",
    "indexer:install": "pnpm --dir indexer install",
    "indexer:dev": "node --env-file-if-exists=.env.local scripts/indexer-config.mjs dev",
    "indexer:codegen": "node --env-file-if-exists=.env.local scripts/indexer-config.mjs codegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@category-labs/mera": "0.2.0",
    "@privy-io/react-auth": "^3.48.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
