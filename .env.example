# One environment for the entire app and its tooling. Build-time: restart dev / rebuild after changing.
# Allowed: mainnet (default), testnet. Users cannot switch this in the app.
NEXT_PUBLIC_SPOOKLY_NETWORK=mainnet

# Privy app ID for sign-in; add your deployment origin in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional bounded issuer sponsorship, strictly testnet. See docs/privy-testnet.md.
PRIVY_GAS_SPONSORSHIP=false
PRIVY_APP_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Aurora Studio application key. Server-only proxy; funding is available only on mainnet.
AURORA_API_KEY=

# Mainnet: explicit Monad EntryPoint 0.7 bundler URL (not an ordinary chain RPC).
BUNDLER_RPC_URL=
# Testnet only: optional Alchemy fallback when BUNDLER_RPC_URL is unset.
# ALCHEMY_API_KEY=

# Optional RPC overrides, both must serve the chain selected above.
# MONAD_RPC_URL=
# NEXT_PUBLIC_MONAD_RPC_URL=

# Deployment only: keep this key in ignored .env.deploy.local, separate from app credentials.
# Read-only checks by default; --broadcast requires an explicit --max-fee MON budget.
# DEPLOYER_PRIVATE_KEY=

# Optional Envio endpoint for the selected environment. Generate/start via root indexer:dev.
# NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
