# Privy app id for issuer sign-in (Google, email, wallets).
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional bounded issuer gas sponsorship, strictly Monad testnet (10143).
# Server only. Enable after configuring Privy and a durable Redis store; see docs/privy-testnet.md.
PRIVY_GAS_SPONSORSHIP=false
PRIVY_APP_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server only: ERC-4337 bundler for Monad testnet. Either an Alchemy key or any EntryPoint 0.7 bundler URL.
ALCHEMY_API_KEY=
# BUNDLER_RPC_URL=
# Optional RPC overrides (default: Monad's public testnet RPC).
# MONAD_RPC_URL=
# NEXT_PUBLIC_MONAD_RPC_URL=
# Deployment only (pnpm deploy): a testnet-only key holding some MON.
# DEPLOYER_PRIVATE_KEY=
# Optional: Envio indexer GraphQL endpoint for payment history and live stats (local: http://localhost:8080/v1/graphql).
# NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
